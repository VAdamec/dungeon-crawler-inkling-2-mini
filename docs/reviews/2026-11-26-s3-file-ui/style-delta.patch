diff --git a/tmp/dungeon-s3-before/style.css b/style.css
index 1caea54..9e2b817 100644
--- a/tmp/dungeon-s3-before/style.css
+++ b/style.css
@@ -145,3 +145,23 @@ canvas:focus-visible { outline: 1px solid #a18c5b; outline-offset: 2px; }
 .companion-footer { display: flex; flex: none; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 24px; border-top: 1px solid #3b4550; font-size: 11px; color: #aab8ce; }
 .companion-choice:focus-visible, .companion-dialog button:focus-visible, #companionPostAction:focus-visible { outline: 3px solid #f4d58b; outline-offset: 3px; }
 @media (max-width: 700px) { .companion-dialog .help-header { align-items: flex-start; flex-wrap: wrap; } .companion-dialog .help-header button { margin-left: auto; } .companion-card { padding: 10px; } .companion-footer { padding: 10px 16px; flex-wrap: wrap; } }
+
+/* Portable save files: a bounded modal with cancellation always in view. */
+#launchLoadGame { display: block; margin: 12px auto 0; }
+#saveFileControls { margin-top: 20px; padding-top: 20px; border-top: 1px solid #3b4550; }
+#saveFileControls > p { font-size: 12px; line-height: 1.7; color: #b2c0cd; }
+.file-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
+.file-status { overflow-wrap: anywhere; white-space: pre-line; color: #c5d3dc; font-size: 12px; line-height: 1.7; }
+.file-status:not(:empty) { margin-top: 10px; }
+#saveLoadOverlay { position: fixed; inset: 0; z-index: 40; display: grid; place-items: center; padding: 20px; background: #050810df; }
+.save-load-dialog { width: min(600px,100%); }
+.save-load-content { min-height: 0; overscroll-behavior: contain; }
+.save-load-content label { display: block; color: #d7ba7b; font-size: 13px; margin-bottom: 12px; }
+#saveLoadFile { width: 100%; min-width: 0; padding: 8px; color: #c5d3dc; font: inherit; font-size: 12px; border: 1px solid #596578; border-radius: 5px; }
+#saveLoadFile::file-selector-button { min-height: 44px; margin-right: 10px; padding: 8px 12px; color: #eadbb4; background: #252b38; border: 1px solid #8b7449; border-radius: 4px; cursor: pointer; }
+#saveLoadPreview { white-space: pre-line; overflow-wrap: anywhere; padding: 14px; margin-top: 16px; border: 1px solid #526352; border-radius: 5px; background: #17241f; color: #d6e6dc; font-size: 13px; line-height: 1.8; }
+.save-load-footer { display: flex; flex-wrap: wrap; gap: 10px; flex: none; padding: 14px 24px; background: #1c2632; border-top: 1px solid #3b4550; }
+.save-load-footer button, .file-actions button, #launchLoadGame, #deathLoadGame { min-height: 44px; }
+#saveLoadAudioToggle { margin-left: auto; }
+#saveLoadOverlay :focus-visible { outline: 2px solid #e0bd6b; outline-offset: 2px; }
+@media (max-width: 700px) { #saveLoadOverlay { padding: 10px; } .save-load-footer { padding: 12px 16px; } #saveLoadAudioToggle { margin-left: 0; } }
